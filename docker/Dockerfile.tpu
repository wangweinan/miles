# doc-dev: docs/developer/ci/02-docker-build.md
# miles on TPU v7x through torch_tpu. Build via docker/build.py:
#       python docker/build.py --variant tpu --image-tag dev --push   # radixark/miles:dev-tpu (amd64)
#
# Two Python environments, because torchtitan v0.3.0 needs torch >= 2.13 while the sglang-torchtpu
# stack pins torch 2.11:
#   system python (/usr/local)  sglang-torchtpu, the rollout engine (`python3 -m sglang.launch_server`)
#   /opt/venvs/train            the torchtitan trainer and miles; sglang stays importable through
#                               --system-site-packages, for its server args and weight-sync buckets
# One torch_tpu wheel carries builds for torch 2.11-2.15, so both environments share its version.

ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

# ======================================== Arguments =============================================

ARG SGLANG_TPU_REPO=sgl-project/sglang-torchtpu
# sglang-torchtpu main + the stacked sgl-project/sglang-torchtpu#1578, #1579, #1580 and the MoE reload fix
# (branch hejian/moe-reload-gmm-layout: checksum, fp32 SiLU, prefill capture skip, MoE weight reload);
# fetched by SHA, which GitHub serves from the PR refs; move to a main commit once they merge.
# .github/workflows/tpu-contract.yml tests this commit.
ARG SGLANG_TPU_COMMIT=b493ae0fd17bf4852235e2b0da54af1c6ef03518
ARG TORCHTITAN_REPO=pytorch/torchtitan
ARG TORCHTITAN_COMMIT=086bf6c166ec85c1298eb5596fa9bf95f6a2d840
ARG TRAINER_TORCH_VERSION=2.13.0
ARG TRAINER_TORCHVISION_VERSION=0.28.0
ARG MILES_COMMIT=main
# the release docker/Dockerfile takes its sgl-router-for-miles build from
ARG WHEELS_REPO=radixark/miles-wheels
ARG WHEELS_TAG=cu130-torch214-x86_64

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SGLANG_BUILD_RUST_EXTS=none \
    SGLANG_PLATFORM=tpu

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential libgomp1 patch \
    && rm -rf /var/lib/apt/lists/*

# ======================================== Rollout engine ========================================

# sglang-torchtpu's own recipe (docker/tpu-base.Dockerfile + docker/tpu.Dockerfile): its TPU manifest pins
# torch, torch_tpu, libtpu and jax together. Without its ray extra: the only `ray` on PATH is the trainer's.
RUN git init -q /sgl-workspace/sglang && cd /sgl-workspace/sglang && \
    git fetch -q --depth 1 https://github.com/${SGLANG_TPU_REPO}.git ${SGLANG_TPU_COMMIT} && git checkout -q FETCH_HEAD && \
    cp python/pyproject_tpu.toml python/pyproject.toml && \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu -e "python[all_tpu]" && \
    pip install --no-deps -e .

# ======================================== Trainer ===============================================

ENV TRAINER_VENV=/opt/venvs/train
RUN python3 -m venv --system-site-packages ${TRAINER_VENV}

# torch_tpu and libtpu match the engine's pins; --ignore-installed keeps the venv's own copies, which load
# the trainer's torch build. triton is imported unconditionally by torchtitan v0.3.0.
RUN printf "torch==${TRAINER_TORCH_VERSION}\ntriton==3.8.0\n" > /opt/trainer-constraints.txt && \
    TORCH_TPU_PIN=$(python3 -c 'import importlib.metadata as m; print(m.version("torch_tpu"))') && \
    LIBTPU_PIN=$(python3 -c 'import importlib.metadata as m; print(m.version("libtpu"))') && \
    ${TRAINER_VENV}/bin/pip install --extra-index-url https://download.pytorch.org/whl/cpu \
        -c /opt/trainer-constraints.txt "torch==${TRAINER_TORCH_VERSION}" "torchvision==${TRAINER_TORCHVISION_VERSION}" triton && \
    ${TRAINER_VENV}/bin/pip install --no-deps --ignore-installed "torch_tpu==${TORCH_TPU_PIN}" "libtpu==${LIBTPU_PIN}"

# torchtitan at the commit docker/Dockerfile pins, with miles' torch_tpu patch (a no-op off TPU)
COPY docker/patch/torchtitan_torch_tpu.patch /tmp/torchtitan_torch_tpu.patch
RUN git clone https://github.com/${TORCHTITAN_REPO}.git /root/torchtitan && \
    cd /root/torchtitan && git checkout -f ${TORCHTITAN_COMMIT} && \
    patch --fuzz=0 -p1 < /tmp/torchtitan_torch_tpu.patch && rm /tmp/torchtitan_torch_tpu.patch && \
    ${TRAINER_VENV}/bin/pip install --no-deps -e . && \
    ${TRAINER_VENV}/bin/pip install -c /opt/trainer-constraints.txt "torchdata>=0.8.0" "torch_checkpointing>=0.1.0" "datasets>=3.6.0,<4.8.0" \
        "tokenizers>=0.15.0" safetensors tyro tensorboard wandb einops pillow "spmd_types==0.2.3"

# miles, without the CUDA-only requirements. Its ray pin lands in the venv, so `ray start` launches every actor
# with the trainer's python.
RUN git clone https://github.com/radixark/miles.git /root/miles && \
    cd /root/miles && git checkout ${MILES_COMMIT} && \
    ${TRAINER_VENV}/bin/pip install --no-deps -e . && \
    grep -vE '^\s*(#|$)|nvidia-resiliency-ext|ring_flash_attn|torchft-nightly' requirements.txt > /tmp/requirements-tpu.txt && \
    ${TRAINER_VENV}/bin/pip install -c /opt/trainer-constraints.txt \
        --extra-index-url https://download.pytorch.org/whl/cpu -r /tmp/requirements-tpu.txt && \
    rm /tmp/requirements-tpu.txt

# miles' router build, as in docker/Dockerfile: the PyPI sglang-router drops return_routed_experts, which
# rollout routing replay needs
RUN curl -fsSL "https://api.github.com/repos/${WHEELS_REPO}/releases/tags/${WHEELS_TAG}" \
    | python3 -c "import json, sys; print(next(a['browser_download_url'] for a in json.load(sys.stdin)['assets'] \
if a['name'].startswith('sglang_router-') and a['name'].endswith('.whl')))" > /tmp/router-url && \
    mkdir /tmp/router && curl -fsSL -o "/tmp/router/$(basename $(cat /tmp/router-url))" "$(cat /tmp/router-url)" && \
    ${TRAINER_VENV}/bin/pip install --no-deps --force-reinstall /tmp/router/sglang_router-*.whl && \
    rm -rf /tmp/router /tmp/router-url

# imports only: importing torch_tpu needs a TPU device, so MILES_ACCELERATOR stays unset here
RUN python3 -c 'import sglang.srt.entrypoints.http_server, sglang_tpu' && \
    ${TRAINER_VENV}/bin/python -c 'import torch, ray, torchtitan.trainer, miles.backends.torchtitan_utils.actor; \
import miles.backends.training_utils.weight_update.protocols.shm, miles.backends.training_utils.weight_update.protocols.disk; \
assert torch.__version__.startswith("'"${TRAINER_TORCH_VERSION}"'"), torch.__version__'

ENV MILES_ACCELERATOR=tpu
WORKDIR /root/miles
CMD ["/bin/bash"]
