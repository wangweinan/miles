+class _AcceleratorDeviceModule:
+    """torch.tpu reserves device/sync/memory calls for torch_tpu itself; route them to torch.accelerator."""
+
+    def __init__(self, fallback: ModuleType):
+        self._fallback = fallback
+
+    def __getattr__(self, name):
+        return getattr(self._fallback, name)
+
+    # Under a launcher each torch_tpu rank owns exactly one device.
+    device_count = staticmethod(
+        lambda: 1 if "LOCAL_RANK" in os.environ else torch.accelerator.device_count()
+    )
+    # Selecting a device before init_process_group breaks the multi-process TPU rendezvous.
+    set_device = staticmethod(
+        lambda device: None if "LOCAL_RANK" in os.environ else torch.accelerator.set_device_index(device)
+    )
+    current_device = staticmethod(torch.accelerator.current_device_index)
+    synchronize = staticmethod(torch.accelerator.synchronize)
+    is_available = staticmethod(torch.accelerator.is_available)
+    empty_cache = staticmethod(torch.accelerator.empty_cache)
+    memory_stats = staticmethod(torch.accelerator.memory_stats)
+    reset_peak_memory_stats = staticmethod(torch.accelerator.reset_peak_memory_stats)
+    max_memory_allocated = staticmethod(torch.accelerator.max_memory_allocated)
+    max_memory_reserved = staticmethod(torch.accelerator.max_memory_reserved)
+    memory = torch.accelerator.memory
+
+
+def integer_cumsum(x: torch.Tensor, dim: int = 0, *, dtype: torch.dtype | None = None) -> torch.Tensor:
+    """``torch.cumsum`` for integer tensors that also lowers on TPU under
+    ``--xla_tpu_use_associative_scan_emitter=false``.
+
+    torch_tpu's integer cumsum fails to lower with that libtpu flag (the sglang engine sets it
+    to work around a scan miscompile), while the float32 cumsum is fine, so on TPU the prefix
+    sum runs in float32 and is cast back. Exact while the sums stay below 2**24.
+    """
+    if device_type != "tpu" or x.is_floating_point():
+        return torch.cumsum(x, dim, dtype=dtype)
+    return torch.cumsum(x, dim, dtype=torch.float32).to(dtype or x.dtype)
+
+
 def get_device_info() -> tuple[str, ModuleType]:
     device_type = _get_available_device_type() or "cuda"
     device_module = _get_device_module(device_type)  # default device_module:torch.cuda
+    if device_type == "tpu":
+        device_module = _AcceleratorDeviceModule(device_module)
     return device_type, device_module
 
 
